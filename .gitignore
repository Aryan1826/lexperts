# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment — NEVER commit secrets
.env
.env.local
backend/.env
backend/.env.local

# Frontend env files are SAFE to commit (no secrets, only VITE_* public vars)
# .env.production and .env.development are intentionally committed

# Logs — ignore content but keep directory placeholder
backend/logs/*.log
backend/logs/*.gz
backend/logs/*-audit.json
*.log
npm-debug.log*
!backend/logs/.gitkeep

# Build output
frontend/dist/
frontend/build/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# PM2
ecosystem.config.js.bak

# EC2 SSH key — NEVER commit this
*.pem
lux.pem

# Uploaded files — keep folder structure but not actual files
backend/uploads/bookings/*
!backend/uploads/bookings/.gitkeep
backend/uploads/sanad/*
!backend/uploads/sanad/.gitkeep
