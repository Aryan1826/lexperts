# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development        # development | production | test
LOG_LEVEL=debug             # debug | info | warn | error

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas: replace <username>, <password>, <cluster>, <dbname>
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_STRING

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Development: http://localhost:5173
# Production:  https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Google Meet (optional — falls back to Jitsi if not set) ──────────────────
# 1. Go to https://console.cloud.google.com → New Project
# 2. Enable "Google Calendar API"
# 3. IAM & Admin → Service Accounts → Create → Download JSON key
# 4. Paste the entire JSON as a single line (escape quotes) in the value below
GOOGLE_SERVICE_ACCOUNT_KEY=REPLACE_ME
# Optional: a specific calendar ID (default: primary)
GOOGLE_CALENDAR_ID=primary

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# Get keys from: https://dashboard.razorpay.com → Settings → API Keys
# Use Test Mode keys during development (prefix: rzp_test_)
RAZORPAY_KEY_ID=rzp_test_Say0FwrEWvSQHp
RAZORPAY_KEY_SECRET=nQPoB3sXIzwEGPrUus00F9Ou

# ─── Email ────────────────────────────────────────────────────────────────────
# Dev: use Ethereal (https://ethereal.email) — auto-generated test account
# Prod: use Gmail App Password or SendGrid API key
# ADD these Gmail lines:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=aryanpatel1826@gmail.com
EMAIL_PASS=jjcxmdsavtknhmcr    ← your 16-char App Password (no spaces)
EMAIL_FROM=LExperts aryanpatel1826@gmail.com
